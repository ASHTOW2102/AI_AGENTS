# Copy this file to .env and edit as needed.

# Speech-to-text ALWAYS uses Hugging Face's Inference Providers (Whisper),
# regardless of MODEL_PROVIDER below - Ollama doesn't do ASR, so this token
# is required even for local dev.
HF_TOKEN=hf_...

# MODEL_PROVIDER selects the backend for the SCORING agent only.
MODEL_PROVIDER=ollama

# --- Ollama (local, free, default scoring backend) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- OpenAI (used only if MODEL_PROVIDER=openai) ---
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# --- Anthropic (used only if MODEL_PROVIDER=anthropic) ---
# ANTHROPIC_API_KEY=...
# ANTHROPIC_MODEL=claude-sonnet-5

# --- Hugging Face (used only if MODEL_PROVIDER=huggingface - e.g. the deployed Space) ---
# HF_MODEL=meta-llama/Llama-3.1-8B-Instruct

MODEL_TEMPERATURE=0.3
MODEL_MAX_TOKENS=2048
