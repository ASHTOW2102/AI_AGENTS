# Copy this file to .env and edit as needed.
# MODEL_PROVIDER selects the whole backend - only this needs to change
# to move from a local Ollama model to a hosted OpenAI/Anthropic model.
MODEL_PROVIDER=ollama

# --- Ollama (local, free, default) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- OpenAI (used only if MODEL_PROVIDER=openai) ---
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# --- Anthropic (used only if MODEL_PROVIDER=anthropic) ---
# ANTHROPIC_API_KEY=...
# ANTHROPIC_MODEL=claude-sonnet-5

# --- Hugging Face Inference Providers (used only if MODEL_PROVIDER=huggingface) ---
# Free tier; used for the deployed HF Space so it doesn't depend on local Ollama.
# HF_TOKEN=hf_...
# HF_MODEL=meta-llama/Llama-3.1-8B-Instruct

# Shared
MODEL_TEMPERATURE=0.3
MODEL_MAX_TOKENS=2048
